<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Базовая тема приложения -->
    <style name="Theme.Jarvis" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/purple_light</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Background -->
        <item name="android:windowBackground">@color/gray_light</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">?attr/colorPrimary</item>
    </style>

    <!-- Фиолетовая тема (используется по умолчанию) -->
    <style name="Theme.Jarvis.Purple" parent="Theme.Jarvis">
        <item name="android:windowBackground">@color/gray_light</item>
    </style>

    <!-- Чёрная тема -->
    <style name="Theme.Jarvis.Black" parent="Theme.Jarvis">
        <item name="android:windowBackground">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <!-- Белая тема -->
    <style name="Theme.Jarvis.White" parent="Theme.Jarvis">
        <item name="android:windowBackground">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
    </style>

    <!-- Стеклянная кнопка (Glassmorphism) -->
    <style name="GlassButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_glass_button</item>
        <item name="android:textColor">@color/purple_primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">32dp</item>
    </style>

    <!-- Стиль для кнопки микрофона (Floating Action Button) -->
    <style name="MicFAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/purple_primary</item>
        <item name="rippleColor">@color/purple_light</item>
        <item name="fabSize">normal</item>
    </style>

</resources>
