<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Базовая тема (фиолетовая) -->
    <style name="Theme.Jarvis" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/purple_light</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/purple_dark</item>
        <item name="android:navigationBarColor">@color/purple_dark</item>
        <!-- Анимации переходов -->
        <item name="android:windowAnimationStyle">@style/WindowAnimations</item>
    </style>

    <!-- Темы вариантов -->
    <style name="Theme.Jarvis.Purple" parent="Theme.Jarvis">
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorPrimary">@color/purple_primary</item>
    </style>

    <style name="Theme.Jarvis.Black" parent="Theme.Jarvis">
        <item name="android:windowBackground">@color/black</item>
        <item name="colorPrimary">@color/dark_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="Theme.Jarvis.White" parent="Theme.Jarvis">
        <item name="android:windowBackground">@color/white</item>
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:statusBarColor">@color/purple_primary</item>
        <item name="android:navigationBarColor">@color/purple_primary</item>
    </style>

    <!-- Стеклянная кнопка -->
    <style name="GlassButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_glass_button</item>
        <item name="android:textColor">@color/purple_primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">32dp</item>
        <item name="android:elevation">8dp</item>
    </style>

    <!-- Стиль FAB с эффектом стекла -->
    <style name="GlassFAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/glass_background</item>
        <item name="rippleColor">@color/purple_light</item>
        <item name="fabSize">normal</item>
        <item name="android:elevation">12dp</item>
        <item name="borderWidth">0dp</item>
    </style>

    <!-- Анимации переходов между активностями -->
    <style name="WindowAnimations">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

</resources>
